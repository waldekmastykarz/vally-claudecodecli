{
  "name": "vally-claudecodecli",
  "version": "0.1.0",
  "description": "Vally executor plugin that evaluates the Claude Code CLI",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "claude-skills",
    "cli",
    "agent-evaluation",
    "ai-evaluation",
    "llm-evaluation",
    "evals",
    "evaluation",
    "benchmarking",
    "testing",
    "ai-agents",
    "agentic-ai",
    "coding-agent",
    "agent-skills",
    "mcp",
    "model-context-protocol",
    "atif",
    "vally",
    "executor",
    "developer-tools"
  ],
  "homepage": "https://github.com/waldekmastykarz/vally-claudecodecli#readme",
  "bugs": {
    "url": "https://github.com/waldekmastykarz/vally-claudecodecli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waldekmastykarz/vally-claudecodecli.git"
  },
  "license": "MIT",
  "author": "Waldek Mastykarz",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@microsoft/vally": ">=0.21.0"
  },
  "dependencies": {
    "atifact": "^0.14.0"
  },
  "devDependencies": {
    "@microsoft/vally": "^0.21.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
